<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fondo full-bleed 100 % borde a borde con degradado horizontal de perspectiva del lomo -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="54"
                android:startX="0"
                android:startY="54"
                android:type="linear">
                <item android:color="#560A18" android:offset="0.0" />
                <item android:color="#7B1124" android:offset="0.26" />
                <item android:color="#871428" android:offset="0.62" />
                <item android:color="#761021" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pliegue vertical sutil del lomo en x = 28.5..30.0 -->
    <path
        android:fillAlpha="0.65"
        android:fillColor="#4D0815"
        android:pathData="M28.5,0 L30.0,0 L30.0,70 L28.5,70 Z" />

</vector>
